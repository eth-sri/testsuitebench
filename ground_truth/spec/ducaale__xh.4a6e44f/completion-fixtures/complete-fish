# Complete paths after @ in options:
function __executable_complete_data
    string match -qr '^(?<prefix>.*@)(?<path>.*)' -- (commandline -ct)
    printf '%s\n' -- $prefix(__fish_complete_path $path)
end
complete -c executable -n 'string match -qr "@" -- (commandline -ct)' -kxa "(__executable_complete_data)"

